# Doxyfile for the Calculation Engine C++ project
# Generate documentation with: doxygen Doxyfile

# Project information
PROJECT_NAME           = "Calculation Engine"
PROJECT_BRIEF          = "A small multi-file C++ project with logging and power calculations."
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs

# Input files
INPUT                  = .
FILE_PATTERNS          = *.h *.hpp *.cpp *.cc
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */build/* */docs/*

# Source parsing
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

# Documentation behavior
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Output formats
GENERATE_HTML          = NO
HTML_OUTPUT            = html
GENERATE_LATEX         = YES
GENERATE_XML           = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_DOCBOOK       = NO

# Diagrams (requires Graphviz for graphs)
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Miscellaneous
QUIET                  = NO
WARNINGS               = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
